var image="";
var color="";
var bytes=0;
color[0]=255;
color[1]=0;
color[2]=0;
image=gd_create(4,3);
bytes=gd_save(image,"/tmp/ewb-gd-transparent.png");
image=gd_fill(image,0,0,color);
image=gd_crop(image,1,1,3,3);
bytes=gd_save(image,"/tmp/ewb-gd-smoke.png");
image=gd_load("/tmp/ewb-gd-smoke.png");
print(bytes>0);
